# SourceMind environment template.
# Copy to .env (or backend/.env / frontend/.env.local) and fill in values you
# actually want to set. NEVER commit a real API key.

# --- Backend ---
# URLs the backend uses to talk to its dependencies. Defaults match
# docker-compose.yml; override for custom setups.
QDRANT_URL=http://localhost:6333
# Local OpenAI-compatible API root only — do NOT append /v1 (the backend adds
# /v1). With docker-compose the backend uses http://llamaedge:8080; from the host
# (venv backend + stack in Docker) use the published port, e.g. http://localhost:9080.
LLAMAEDGE_BASE_URL=http://localhost:9080
# Optional; llama.cpp ignores this — placeholder for the OpenAI SDK.
# LLAMAEDGE_API_KEY=not-needed
# Default chat model id (must match GET /v1/models for your GGUF).
LLAMAEDGE_DEFAULT_CHAT_MODEL=Qwen3-1.7B-Q8_0.gguf

# GGUF path *inside* the llamaedge container (Compose: ./models is mounted at /models).
LLAMAEDGE_MODEL_GGUF=/models/Qwen3-1.7B-Q8_0.gguf

# Optional. Most users should leave this blank and paste their key into the
# OpenAI Settings panel in the web UI. Setting it here makes /ask-openai-stream
# work without a per-request header (handy for local dev only).
# OPENAI_API_KEY=

# --- Frontend ---
# Where the browser should send API calls. For docker-compose, the backend is
# exposed on the host at http://localhost:8000.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
